{
  "$schema": "https://raw.githubusercontent.com/cobre-rs/cobre/refs/heads/main/schemas/generic_constraints.schema.json",
  "constraints": [
    {
      "id": 1,
      "name": "min_stored_energy_h0",
      "description": "Minimum stored energy constraint using computed coefficient",
      "expression": "@rho_acum_h0 * hydro_storage(0)",
      "slack": {
        "enabled": true,
        "penalty": 5000.0
      }
    }
  ]
}
